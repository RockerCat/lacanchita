# Valores PÚBLICOS del proyecto Supabase lacanchita (ref cfzxentitxytnvvumfpv).
# Copiar a .env.local. La clave publishable es pública por diseño (RLS protege los datos);
# NUNCA poner aquí service_role, secret keys, contraseñas ni cadenas de conexión.
NEXT_PUBLIC_SUPABASE_URL=https://cfzxentitxytnvvumfpv.supabase.co
# Obtener con: npx supabase projects api-keys --project-ref cfzxentitxytnvvumfpv  (tipo "publishable")
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Opcional en local; OBLIGATORIO en producción: origen público usado en los enlaces de invitación
# y en el retorno de la confirmación de correo (p. ej. https://lacanchita.example). Sin barra final.
# NEXT_PUBLIC_SITE_URL=
